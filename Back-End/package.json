{
  "name": "back-end",
  "version": "1.0.0",
  "description": "Back-End",
  "main": "index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "predev": "npm run build",
    "dev": "cross-env NODE_ENV=development concurrently \"tsc --watch\" \"nodemon -q --inspect dist/src/index.js\"",
    "prestart": "npm run build",
    "start": "cross-env NODE_ENV=production node dist/index.js"
  },
