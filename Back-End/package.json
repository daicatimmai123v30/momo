    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fs": "^0.0.1-security",
    "mongoose": "^8.13.0",
    "node-cron": "^3.0.3",
    "path": "^0.12.7",
    "puppeteer": "^24.4.0",
    "puppeteer-core": "^24.4.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
